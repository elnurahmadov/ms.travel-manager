<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
                   http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2-create-destinations" author="elnur">
        <createTable tableName="destinations">
            <column name="id" type="BIGINT" autoIncrement="true"/>
            <column name="location" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="visit_date" type="DATE"/>
            <column name="tour_id" type="BIGINT"/>
        </createTable>
        <addPrimaryKey tableName="destinations" columnNames="id" constraintName="pk_destinations"/>
        <addForeignKeyConstraint
                baseTableName="destinations"
                baseColumnNames="tour_id"
                referencedTableName="tours"
                referencedColumnNames="id"
                constraintName="fk_destinations_tour"/>
    </changeSet>

</databaseChangeLog>
