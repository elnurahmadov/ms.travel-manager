<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
                   http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="7-create-tour-travelers" author="elnur">
        <createTable tableName="tour_travelers">
            <column name="tour_id" type="BIGINT"/>
            <column name="traveler_id" type="BIGINT"/>
        </createTable>
        <addPrimaryKey tableName="tour_travelers" columnNames="tour_id, traveler_id"
                       constraintName="pk_tour_travelers"/>
        <addForeignKeyConstraint
                baseTableName="tour_travelers"
                baseColumnNames="tour_id"
                referencedTableName="tours"
                referencedColumnNames="id"
                constraintName="fk_tour_travelers_tour"/>
        <addForeignKeyConstraint
                baseTableName="tour_travelers"
                baseColumnNames="traveler_id"
                referencedTableName="travelers"
                referencedColumnNames="id"
                constraintName="fk_tour_travelers_traveler"/>
    </changeSet>

</databaseChangeLog>
